<%- include('partials/header') %>
<div class="page-heading"><div><p class="eyebrow">Owner</p><h1>School overview</h1><p class="muted">Review class rankings and the all-school performance table.</p></div></div>
<div class="stats"><div class="metric"><strong><%= counts.students %></strong><span>Students</span></div><div class="metric"><strong><%= counts.teachers %></strong><span>Teachers</span></div><div class="metric"><strong><%= counts.scores %></strong><span>Scores recorded</span></div></div>
<section class="panel"><div class="section-heading"><div><h2>Class ranking</h2><p class="muted">Filter the ranking by class.</p></div><form method="get" action="/owner/dashboard" class="filter-form"><label>Class<select name="className" onchange="this.form.submit()"><option value="">All classes</option><% classes.forEach((item) => { %><option value="<%= item.className %>" <%= item.className === classFilter ? 'selected' : '' %>><%= item.className %></option><% }) %></select></label></form></div><% if (!ranking.length) { %><p class="muted">Rankings appear after scores are entered.</p><% } else { %><ol class="ranking"><% ranking.forEach((row, index) => { %><li class="<%= index === 0 ? 'best-in-class' : '' %>"><span><b>#<%= index + 1 %></b> <%= row.fullName %><% if (index === 0) { %><em>Best in class</em><% } %><small><%= row.className %> · <%= row.scoreCount %> scores</small></span><strong><%= Number(row.average).toFixed(1) %>%</strong></li><% }) %></ol><% } %></section>
<section class="panel"><h2>All-school table</h2><% if (!allSchool.length) { %><p class="muted">No students have been added yet.</p><% } else { %><table><thead><tr><th>Student</th><th>Admission</th><th>Class</th><th>Average</th><th>Scores</th></tr></thead><tbody><% allSchool.forEach((row) => { %><tr><td><%= row.fullName %></td><td><%= row.admissionNumber %></td><td><%= row.className %></td><td><strong><%= row.average === null ? '—' : Number(row.average).toFixed(1) + '%' %></strong></td><td><%= row.scoreCount %></td></tr><% }) %></tbody></table><% } %></section>
<%- include('partials/footer') %>
