<%- include('partials/header') %>
<div class="page-heading"><div><p class="eyebrow">Class teacher</p><h1><%= className %></h1><p class="muted">Enter or update results for students in your own class only. Existing subject scores are safely upserted.</p></div></div>
<section class="panel score-entry"><h2>Record a score</h2><form method="post" action="/teacher/scores" class="score-form"><label>Student<select name="studentId" required><option value="">Choose student</option><% students.forEach((student) => { %><option value="<%= student.id %>"><%= student.fullName %></option><% }) %></select></label><label>Subject<select name="subject" required><% subjects.forEach((subject) => { %><option><%= subject.name %></option><% }) %></select></label><label>Score<input type="number" name="score" min="0" max="100" step="0.1" required></label><button class="button primary" type="submit">Save score</button></form></section>
<section class="panel"><h2>Students and ranking</h2><% if (!students.length) { %><p class="muted">No students are assigned to this class yet.</p><% } else { %><table><thead><tr><th>#</th><th>Student</th><th>Admission</th><th>Average</th><th>Scores</th></tr></thead><tbody><% students.forEach((student, index) => { %><tr><td><b>#<%= index + 1 %></b></td><td><%= student.fullName %><small><%= student.email %></small></td><td><%= student.admissionNumber %></td><td><strong><%= student.average === null ? '—' : Number(student.average).toFixed(1) + '%' %></strong></td><td><%= student.scoreCount %></td></tr><% }) %></tbody></table><% } %></section>
<%- include('partials/footer') %>
