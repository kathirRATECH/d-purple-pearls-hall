<%- include('partials/header') %>
<section class="auth-card"><p class="eyebrow">Teacher portal</p><h1>Teacher login</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (query && query.created) { %><div class="alert success">Account created. You can log in now.</div><% } %>
  <form method="post" action="/teacher/login" class="stack">
    <label>Email<input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="username"></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="button primary" type="submit">Log in</button>
  </form>
  <p class="muted">Need an account? <a href="/teacher/signup">Teacher signup</a></p>
</section>
<%- include('partials/footer') %>
