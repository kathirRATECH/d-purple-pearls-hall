<%- include('partials/header') %>
<section class="auth-card"><p class="eyebrow">Student portal</p><h1>Student login</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (query && query.created) { %><div class="alert success">Account created. You can log in now.</div><% } %>
  <form method="post" action="/student/login" class="stack">
    <label>Admission number or email<input name="identifier" value="<%= values.identifier || '' %>" required autocomplete="username"></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="button primary" type="submit">Log in</button>
  </form>
  <p class="muted">Need an account? <a href="/student/signup">Student signup</a></p>
</section>
<%- include('partials/footer') %>
